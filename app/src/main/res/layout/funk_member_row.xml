<?xml version="1.0" encoding="utf-8"?>
<!-- One person in the display of the walkie-talkie screen and in the popup list (both dark). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/funk_member_row_height"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/member_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/funk_dot_idle" />

    <TextView
        android:id="@+id/member_name"
        android:importantForAccessibility="no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/funk_on_surface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/member_channel"
        android:importantForAccessibility="no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxWidth="120dp"
        android:singleLine="true"
        android:textColor="@color/funk_on_surface_muted"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/member_muted"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_funk_mic_off"
        android:visibility="gone"
        app:tint="@color/funk_on_surface_muted" />
</LinearLayout>
