<!-- Mumla Funk: one chat message as a flat bubble with 16 dp corners (like the lists inside
     the Funk display), sender and time muted. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?cardStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:id="@+id/list_chat_item_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/list_chat_item_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="example username → channel"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/list_chat_item_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="example message"
            android:textColor="?attr/colorOnSurface"
            android:textColorLink="?attr/colorPrimary"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/list_chat_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23:23:23"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
