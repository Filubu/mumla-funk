<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/channel_row_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/channel_row_expand"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_action_collapsed"
        app:tint="?attr/colorOnSurfaceVariant"
        android:padding="14dp" />

    <TextView
        android:id="@+id/channel_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical|left"
        android:minHeight="48dp"
        android:padding="4dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:text="Channel name\nLine 2\nLine 3\nLine 4"/>

    <TextView
        android:id="@+id/channel_row_count"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="10"
        android:fontFamily="sans-serif-medium"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:padding="10dp"/>

    <ImageView
        android:id="@+id/channel_row_join"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_action_move"
        android:padding="4dp"
        app:tint="?attr/colorOnSurfaceVariant"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <ImageView
        android:id="@+id/channel_row_more"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_more_vert_black_24dp"
        android:layout_gravity="center"
        android:paddingLeft="8dp"
        app:tint="?attr/colorOnSurfaceVariant"
        android:background="?attr/selectableItemBackgroundBorderless"/>
</LinearLayout>