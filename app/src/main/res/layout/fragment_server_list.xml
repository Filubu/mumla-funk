<!-- Mumla Funk: the start screen. A short hint above the list, a welcome text with buttons
     while there is no server yet, and a button to add one. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/server_list_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp"
            android:text="@string/server_list_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <GridView
            android:id="@+id/server_list_grid"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:gravity="center"
            android:columnWidth="320dp"
            android:numColumns="auto_fit"
            android:verticalSpacing="12dp"
            android:horizontalSpacing="12dp"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp"
            android:stretchMode="columnWidth"
            android:clipToPadding="false"
            android:fastScrollEnabled="true"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/server_list_grid_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_funk_circle_accent"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_funk_walkie" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/welcome_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxWidth="420dp"
                android:text="@string/welcome_text"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/server_list_welcome_add"
                style="@style/Widget.Funk.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:minHeight="56dp"
                android:paddingStart="24dp"
                android:paddingEnd="28dp"
                android:text="@string/funk_add_server"
                android:textSize="15sp"
                app:icon="@drawable/ic_funk_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/server_list_welcome_public"
                style="@style/Widget.Funk.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/welcome_public_servers" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:maxWidth="420dp"
                android:text="@string/welcome_funk_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/server_list_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/funk_add_server"
        app:icon="@drawable/ic_funk_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
