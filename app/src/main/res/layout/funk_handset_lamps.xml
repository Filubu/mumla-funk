<?xml version="1.0" encoding="utf-8"?>
<!-- Status lamps of the handheld radio design: NET (connected, amber), RX (somebody else is
     talking, red), TX (I am transmitting, green). Decorative: the display says the same. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/handset_lamp_net"
        style="@style/Widget.Funk.Handset.Lamp"
        android:text="@string/handset_lamp_net"
        app:drawableStartCompat="@drawable/handset_lamp_off" />

    <TextView
        android:id="@+id/handset_lamp_rx"
        style="@style/Widget.Funk.Handset.Lamp"
        android:layout_marginStart="10dp"
        android:text="@string/handset_lamp_rx"
        app:drawableStartCompat="@drawable/handset_lamp_off" />

    <TextView
        android:id="@+id/handset_lamp_tx"
        style="@style/Widget.Funk.Handset.Lamp"
        android:layout_marginStart="10dp"
        android:text="@string/handset_lamp_tx"
        app:drawableStartCompat="@drawable/handset_lamp_off" />
</LinearLayout>
