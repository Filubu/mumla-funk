<?xml version="1.0" encoding="utf-8"?>
<!-- Mumla Funk push-to-talk popup: a single floating card over a dimmed background, with the
     server, a short list of who is online and the big talk button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ptt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funk_scrim"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/ptt_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="12dp"
        android:background="@drawable/bg_funk_card"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ptt_status_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_funk_tower_off"
                app:tint="@color/funk_on_surface_muted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ptt_server_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/funk_on_surface"
                    android:textSize="17sp"
                    tools:text="Funkserver" />

                <TextView
                    android:id="@+id/ptt_server_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/funk_on_surface_muted"
                    android:textSize="13sp"
                    tools:text="Lobby · 4 online" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/ptt_open_app"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/funk_open_app"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_funk_open"
                app:tint="@color/funk_on_surface_muted" />

            <ImageButton
                android:id="@+id/ptt_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/funk_close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_funk_close"
                app:tint="@color/funk_on_surface_muted" />
        </LinearLayout>

        <!-- Who is on the server. Shows up to 5 rows (fewer on short screens), scrolls if
             there are more; the height is set in PttActivity. -->
        <ScrollView
            android:id="@+id/ptt_users_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_funk_list"
            android:fadeScrollbars="false"
            android:fadingEdgeLength="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:requiresFadingEdge="vertical"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:layout_height="188dp"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/ptt_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <se.lublin.mumla.funk.PttButtonView
            android:id="@+id/ptt_button"
            android:layout_width="216dp"
            android:layout_height="216dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/ptt_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/funk_on_surface"
            android:textSize="20sp"
            tools:text="Halten zum Sprechen" />

        <TextView
            android:id="@+id/ptt_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:minLines="1"
            android:textColor="@color/funk_on_surface_muted"
            android:textSize="14sp"
            tools:text="oder Leiser-Taste halten" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptt_action"
            style="@style/Widget.Funk.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            tools:text="In App öffnen"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
