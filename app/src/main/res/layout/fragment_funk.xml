<?xml version="1.0" encoding="utf-8"?>
<!-- Mumla Funk walkie-talkie screen: a dark display on top (server, ping, who is talking, who
     is online; the list scrolls inside the display) and, straight on the background of the
     app, the channel switch and the big push-to-talk button, within thumb reach.
     Landscape: layout-land/fragment_funk.xml, same ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/funk_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <include
        layout="@layout/funk_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/funk_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />
</LinearLayout>
