<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channelcontainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/channel_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.viewpager.widget.PagerTabStrip
            android:id="@+id/channel_tab_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"/>
    </androidx.viewpager.widget.ViewPager>

    <!-- Mumla Funk: the shout/whisper banner as a quiet indigo-tinted strip. -->
    <FrameLayout
        android:id="@+id/target_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSecondaryContainer">

        <TextView
            android:id="@+id/target_panel_warning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:text="Shouting to Channel"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <ImageView
            android:id="@+id/target_panel_cancel"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_action_delete_dark"
            app:tint="?attr/colorOnSecondaryContainer" />

    </FrameLayout>

    <!-- Mumla Funk: the push-to-talk bar in the colors of the Funk talk button (indigo, red
         while transmitting). The pill is drawn inset (Widget.Funk.PttBar), the touch area is
         still the whole bar; its height comes from the settings (ChannelFragment). -->
    <LinearLayout
        android:id="@+id/pushtotalk_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pushtotalk"
            style="@style/Widget.Funk.PttBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/ptt" />
    </LinearLayout>

</LinearLayout>
