<?xml version="1.0" encoding="utf-8"?>
<!-- The display of the walkie-talkie screen. Always dark, like the popup and the widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/funk_display"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_funk_display"
    android:minHeight="168dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Server, channel and connection quality -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/funk_status_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_funk_tower_off"
            app:tint="@color/funk_on_surface_muted" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/funk_server_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/funk_on_surface"
                android:textSize="17sp"
                tools:text="Funkserver" />

            <TextView
                android:id="@+id/funk_server_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/funk_on_surface_muted"
                android:textSize="13sp"
                tools:text="Lobby · 4 online" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/funk_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_funk_list"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/funk_ping_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_funk_signal"
                app:tint="@color/funk_live" />

            <TextView
                android:id="@+id/funk_ping_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:textColor="@color/funk_on_surface"
                android:textSize="13sp"
                tools:text="42 ms" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/funk_divider" />

    <!-- Who is talking right now, like the caller ID of a radio -->
    <TextView
        android:id="@+id/funk_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/funk_on_surface"
        android:textSize="24sp"
        tools:text="Max spricht" />

    <TextView
        android:id="@+id/funk_now_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/funk_on_surface_muted"
        android:textSize="13sp"
        tools:text="Zuletzt: Anna · 14:32" />

    <!-- Who is online. Scrolls inside the display, the talk button stays in place. -->
    <LinearLayout
        android:id="@+id/funk_users_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/funk_divider" />

        <TextView
            android:id="@+id/funk_users_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/funk_on_surface_muted"
            android:textSize="12sp"
            tools:text="Online · 4" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/funk_users_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/funk_users"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/funk_users_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:text="@string/funk_nobody_online"
                    android:textColor="@color/funk_on_surface_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
