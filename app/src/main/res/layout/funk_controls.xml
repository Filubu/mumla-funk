<?xml version="1.0" encoding="utf-8"?>
<!-- Lower part of the walkie-talkie screen, from the top: the channel switch (previous, the
     current channel, next), the big talk button with its label, and two quiet buttons at the
     bottom (power, channels & chat). The channel switch is only there while connected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/funk_channel_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/funk_channel_prev"
            style="@style/Widget.Funk.Button.IconOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/handset_channel_prev_desc"
            app:icon="@drawable/ic_funk_chevron_left" />

        <!-- The channel and its place in the list; a tap opens the list. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/funk_channel_pick"
            style="@style/Widget.Funk.Button.Tonal.Icon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            app:icon="@drawable/ic_funk_chevron_down"
            app:iconGravity="textEnd"
            tools:text="Lobby · 2/5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/funk_channel_next"
            style="@style/Widget.Funk.Button.IconOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/handset_channel_next_desc"
            app:icon="@drawable/ic_funk_chevron_right" />
    </LinearLayout>

    <se.lublin.mumla.funk.PttButtonView
        android:id="@+id/funk_ptt"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/funk_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="Halten zum Sprechen" />

    <TextView
        android:id="@+id/funk_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:minLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Tippen zum Aktivieren" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/funk_connect_toggle"
            style="@style/Widget.Funk.Button.Text.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_funk_power"
            tools:text="Trennen" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/funk_channels"
            style="@style/Widget.Funk.Button.Text.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/funk_channels_chat"
            app:icon="@drawable/ic_funk_chat" />
    </LinearLayout>
</LinearLayout>
