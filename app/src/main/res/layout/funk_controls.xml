<?xml version="1.0" encoding="utf-8"?>
<!-- Lower part of the walkie-talkie screen: side buttons, the big talk button and its label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/funk_connect_toggle"
            style="@style/Widget.Funk.Button.Outlined.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_funk_power"
            tools:text="Trennen" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/funk_channels"
            style="@style/Widget.Funk.Button.Tonal.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/funk_channels_chat"
            app:icon="@drawable/ic_funk_chat" />
    </LinearLayout>

    <se.lublin.mumla.funk.PttButtonView
        android:id="@+id/funk_ptt"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/funk_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="Halten zum Sprechen" />

    <TextView
        android:id="@+id/funk_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:minLines="1"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Tippen zum Aktivieren" />
</LinearLayout>
