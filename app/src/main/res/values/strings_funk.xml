    <string name="pref_funk_energy_category">Energy saving</string>
    <string name="pref_funk_energy_saving_title">Save energy while nobody talks</string>
    <string name="pref_funk_energy_saving_summary">From 30 s after the last transmission: only one keep-alive ping every few minutes, voice over TCP. If battery optimization is off, the phone may also sleep. Transmissions still come through right away.</string>
    <string name="pref_funk_idle_keepalive_title">Keep-alive ping while idle</string>
    <string-array name="funk_idle_keepalive_names">
        <item>20 s – works with every server</item>
        <item>1 min – server timeout of 120 s or more</item>
        <item>2 min – server timeout of 300 s or more (recommended)</item>
        <item>4 min – server timeout of 600 s or more</item>
    </string-array>
    <string-array name="funk_idle_keepalive_values" translatable="false">
        <item>20</item>
        <item>60</item>
        <item>120</item>
        <item>240</item>
    </string-array>
    <string name="pref_funk_battery_title">Allow sleeping (battery optimization)</string>
    <string name="pref_funk_battery_on">Done: Mumla Funk is exempt from battery optimization, the phone may sleep while nobody talks.</string>
    <string name="pref_funk_battery_off">Tap, find Mumla Funk in the list and choose \"Don\'t optimize\" or \"Unrestricted\". Otherwise the phone is kept awake while connected and only the radio saves energy.</string>

