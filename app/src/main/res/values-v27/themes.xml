<?xml version="1.0" encoding="utf-8"?>
<!-- Light theme from API 27: dark icons in the status bar and the navigation bar, both in
     the background color. The dark theme (values-night/themes.xml) takes precedence. -->
<resources>
    <style name="Theme.Mumla" parent="Base.Theme.Mumla">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/ui_surface</item>
    </style>
</resources>
