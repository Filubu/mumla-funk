    <string name="welcome_title">Willkommen bei Mumla Funk</string>
    <string name="welcome_text">Mumla Funk verbindet sich mit jedem Mumble-Server. Füge zuerst deinen Server hinzu. Adresse und, falls nötig, Passwort bekommst du von der Person, die den Server betreibt.</string>
    <string name="welcome_public_servers">Öffentliche Server ansehen</string>
    <string name="welcome_funk_note">Funk-Server bekommen einen großen Sprechknopf, das Funk-Fenster und die Widgets. Andere Server zeigen die gewohnte Mumble-Ansicht mit Kanälen und Chat. Das legst du für jeden Server fest.</string>
    <string name="server_edit_title_add">Server hinzufügen</string>
    <string name="server_edit_title_edit">Server bearbeiten</string>
    <string name="server_edit_save">Speichern</string>
    <string name="server_edit_intro">Die Angaben bekommst du von der Person, die den Server betreibt.</string>
    <string name="server_edit_host_placeholder">z. B. mumble.example.org</string>
    <string name="server_edit_host_invalid">Nur die Adresse eingeben, z. B. mumble.example.org</string>
    <string name="server_edit_username_helper">So sehen dich die anderen. Am besten ohne Leerzeichen.</string>
    <string name="server_edit_username_missing">Bitte einen Namen eingeben.</string>
    <string name="server_edit_password_hint">Passwort (optional)</string>
    <string name="server_edit_password_helper">Nur nötig, wenn der Server ein Passwort hat.</string>
    <string name="server_edit_name_hint">Name in der Liste (optional)</string>
    <string name="server_edit_funk">Funk-Server</string>
    <string name="server_edit_funk_summary">An: großer Sprechknopf, Funk-Fenster und Widgets. Aus: die gewohnte Mumble-Ansicht mit Kanälen und Chat.</string>
    <string name="server_added">%1$s gespeichert</string>
    <string name="funk_cert_title">Diesem Server vertrauen?</string>
    <string name="funk_cert_message">%1$s weist sich mit einem eigenen Zertifikat aus, das Android nicht kennt. Bei privaten Mumble-Servern ist das normal. Vertraue ihm, wenn du die Adresse von der Person hast, die den Server betreibt. Die App merkt sich das Zertifikat und warnt, falls es sich ändert.</string>
    <string name="funk_cert_trust">Vertrauen und verbinden</string>
    <string name="funk_server_removed">Server gelöscht</string>
    <string name="funk_server_removed_hint">Den Server dieses Widgets gibt es nicht mehr. Widget lange drücken, um einen anderen zu wählen.</string>

