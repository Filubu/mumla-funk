<?xml version="1.0" encoding="utf-8"?>
<!-- Row of a person in Mumla's channel list. While they talk (activated, set in
     ChannelListAdapter) it gets the tinted, rounded highlight of the Funk display rows, faded
     in and out. Pressed: a ripple in the same shape. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ui_ripple">
    <item
        android:id="@android:id/mask"
        android:left="8dp"
        android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:right="8dp">
        <selector
            android:enterFadeDuration="@integer/funk_motion_change"
            android:exitFadeDuration="@integer/funk_motion_release">
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/funk_talking_row" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
</ripple>
