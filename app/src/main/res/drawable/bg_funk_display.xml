<?xml version="1.0" encoding="utf-8"?>
<!-- The "display" of the walkie-talkie screen: always dark, like the popup and the widgets. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/funk_display_bottom"
        android:startColor="@color/funk_display_top" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/funk_divider" />
</shape>
