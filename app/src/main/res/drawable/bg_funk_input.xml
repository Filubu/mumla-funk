<?xml version="1.0" encoding="utf-8"?>
<!-- Text field without underline: a rounded, filled field (chat, access tokens). The outline
     turns indigo while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@integer/funk_motion_press"
    android:exitFadeDuration="@integer/funk_motion_press">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <stroke android:width="1.5dp" android:color="@android:color/transparent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
