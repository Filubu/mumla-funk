<?xml version="1.0" encoding="utf-8"?>
<!-- Amber power key of the handheld radio design: switch on (connect).
     A raised key with a light top edge and a dark lower edge; pressed, the face moves down
     onto the edge. Keyboard focus gets an amber ring. Text color: color/handset_key_text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/handset_power_edge" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="1dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/handset_power_light" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="1dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/handset_power_bottom"
                        android:startColor="@color/handset_power_top" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/handset_power_edge" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/handset_power_light" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/handset_power_bottom"
                        android:startColor="@color/handset_power_top" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/handset_amber" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/handset_power_edge" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/handset_power_light" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/handset_power_bottom"
                        android:startColor="@color/handset_power_top" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
