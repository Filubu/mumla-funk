<?xml version="1.0" encoding="utf-8"?>
<!-- Housing of the handheld radio design: a dark rim, a light top edge and a dark body that
     gets darker towards the bottom. The first layer gives the outline for the shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/handset_housing_edge" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/handset_housing_light" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/handset_housing_bottom"
                android:startColor="@color/handset_housing_top" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
