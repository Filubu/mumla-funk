<?xml version="1.0" encoding="utf-8"?>
<!-- Display of the handheld radio design: a bezel with a light lower edge, a black rim and
     the screen, lighter at the top. Scan lines and the dark inner edge are drawn on top by
     FunkHandset.LcdOverlay (screen area: 5 dp in, 6 dp at the bottom, corners 13 dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/handset_bezel_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/handset_bezel" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0"
                android:endColor="@color/handset_lcd_bottom"
                android:gradientRadius="360dp"
                android:startColor="@color/handset_lcd_top"
                android:type="radial" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
