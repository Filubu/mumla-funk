<?xml version="1.0" encoding="utf-8"?>
<!-- Mumla Funk: design, shortcuts for the walkie-talkie popup, and energy saving. -->
<androidx.preference.PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Look of the walkie-talkie screen and popup, see FunkPrefs.isHandsetDesign(). -->
    <ListPreference
        app:defaultValue="modern"
        app:entries="@array/funk_design_names"
        app:entryValues="@array/funk_design_values"
        app:iconSpaceReserved="false"
        app:key="funk_design"
        app:title="@string/pref_funk_design_title"
        app:useSimpleSummaryProvider="true" />
    <Preference
        app:key="funk_assistant"
        app:iconSpaceReserved="false"
        app:title="@string/pref_funk_assistant_title" />
    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:iconSpaceReserved="false"
        app:key="funk_volume_ptt_in_popup"
        app:summary="@string/pref_funk_volume_ptt_summary"
        app:title="@string/pref_funk_volume_ptt_title" />
    <!-- Audio focus like a navigation app, see Humla's MediaDucker. -->
    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:iconSpaceReserved="false"
        app:key="funk_duck_media"
        app:summary="@string/pref_funk_duck_media_summary"
        app:title="@string/pref_funk_duck_media_title" />
    <!-- Android 16+ only, see FunkSettingsFragment. -->
    <Preference
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="funk_live_update"
        app:title="@string/pref_funk_live_title" />

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="funk_energy"
        app:title="@string/pref_funk_energy_category">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="funk_energy_saving"
            app:summary="@string/pref_funk_energy_saving_summary"
            app:title="@string/pref_funk_energy_saving_title" />
        <ListPreference
            app:defaultValue="120"
            app:dependency="funk_energy_saving"
            app:entries="@array/funk_idle_keepalive_names"
            app:entryValues="@array/funk_idle_keepalive_values"
            app:iconSpaceReserved="false"
            app:key="funk_idle_keepalive"
            app:title="@string/pref_funk_idle_keepalive_title"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:dependency="funk_energy_saving"
            app:iconSpaceReserved="false"
            app:key="funk_battery_optimization"
            app:title="@string/pref_funk_battery_title" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
