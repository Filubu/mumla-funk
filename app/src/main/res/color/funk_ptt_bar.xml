<?xml version="1.0" encoding="utf-8"?>
<!-- Mumla's push-to-talk bar, in the colors of the Funk talk button: indigo when ready,
     red while transmitting (pressed, or switched on in toggle mode). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/funk_talk" />
    <item android:state_activated="true" android:color="@color/funk_talk" />
    <item android:color="@color/ui_accent_fill" />
</selector>
