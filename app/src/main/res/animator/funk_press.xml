<?xml version="1.0" encoding="utf-8"?>
<!-- Mumla Funk motion: shrinks slightly while pressed and springs back when let go.
     Durations follow the system animation scale (off when animations are turned off). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/funk_motion_press"
                android:interpolator="@interpolator/funk_standard"
                android:propertyName="scaleX"
                android:valueTo="0.96"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/funk_motion_press"
                android:interpolator="@interpolator/funk_standard"
                android:propertyName="scaleY"
                android:valueTo="0.96"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@integer/funk_motion_release"
                android:interpolator="@interpolator/funk_spring"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/funk_motion_release"
                android:interpolator="@interpolator/funk_spring"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
