<?xml version="1.0" encoding="utf-8"?>
<!-- Walkie-talkie screen in the handheld radio design, landscape: lamps and display on the
     left, keys on the right. No antenna, it would cost height. Same ids as
     layout/fragment_funk_handset.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/funk_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="12dp"
    android:background="@drawable/bg_handset_housing"
    android:baselineAligned="false"
    android:elevation="6dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        tools:ignore="NestedWeights">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:text="@string/handset_brand"
                android:textAppearance="@style/TextAppearance.Funk.Handset.Plate" />

            <include layout="@layout/funk_handset_lamps" />
        </LinearLayout>

        <include
            layout="@layout/funk_handset_lcd"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/funk_channel_prev"
                style="@style/Widget.Funk.Handset.Key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/handset_channel_prev_desc"
                android:text="@string/handset_channel_prev" />

            <TextView
                android:id="@+id/funk_channels"
                style="@style/Widget.Funk.Handset.Key.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/funk_channels_chat"
                android:text="@string/handset_channel_list" />

            <TextView
                android:id="@+id/funk_channel_next"
                style="@style/Widget.Funk.Handset.Key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/handset_channel_next_desc"
                android:text="@string/handset_channel_next" />
        </LinearLayout>

        <!-- The height follows the screen (FunkFragment.sizeButton). -->
        <se.lublin.mumla.funk.PttButtonView
            android:id="@+id/funk_ptt"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/handset_plate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Funk.Handset.Plate"
                tools:text="MF-1 · 1.0.6" />

            <TextView
                android:id="@+id/funk_connect_toggle"
                style="@style/Widget.Funk.Handset.Key.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Aus" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
